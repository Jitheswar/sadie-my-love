#!/usr/bin/env python3
"""Render btop.theme from the theme's current colors.toml.

btop is the one app whose theme Omarchy cannot generate well for us. The stock
template sets theme[main_bg] to the palette background, which makes btop an
opaque slab inside a terminal this theme deliberately runs at 0.96 opacity, and
it paints box titles in plain foreground where this theme wants amber. So the
layout below is hand-designed and stays that way.

What it must not do is stay *fixed*. colors.toml is swapped per wallpaper by
bin/apply-palette, and a hand-written btop.theme would keep the reference
palette's copper while the bar, borders, and terminal all rotate away from it --
up to 19 degrees on wallpaper 02, which is plainly visible side by side.

So the hand-tuned design is expressed once against the reference palette, and
the wallpaper's rotation is re-applied to it here, exactly as the palette
generator does for colors.toml itself. The tuning is preserved and the result
still tracks the wallpaper, because lightness and chroma never move.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from oklch import hue_delta, rotate  # noqa: E402

THEME = Path(__file__).resolve().parent.parent
COLORS = THEME / "colors.toml"
OUTPUT = THEME / "btop.theme"

# The accent as it appears in the untouched reference palette. The rotation to
# apply is however far the live palette's accent has moved from this.
REFERENCE_ACCENT = "#c9714f"

# Near-neutral slots rotate less, mirroring NEUTRAL_DAMPING in
# bin/generate-palettes: a hue shift on something with almost no chroma reads
# as a colour cast on what should be plain text or a plain divider.
DAMPING = {
    "main_fg": 0.35, "selected_fg": 0.3, "inactive_fg": 0.5, "div_line": 0.6,
}

# Hand-tuned design, expressed against the reference palette. Each group is a
# comment followed by its slots; `RAW` lines are emitted verbatim because they
# are btop switches rather than colours.
RAW = object()

DESIGN = [
    ("Main background, empty for terminal default (keeps transparency)", [
        ("main_bg", ""),
        (RAW, "theme_background=false"),
    ]),
    ("Main text color", [("main_fg", "#e8ddd4")]),
    ("Title color for boxes", [("title", "#f2bb63")]),
    ("Highlight color for keyboard shortcuts", [("hi_fg", "#c9714f")]),
    ("Background color of selected item in processes box", [("selected_bg", "#54313a")]),
    ("Foreground color of selected item in processes box", [("selected_fg", "#faf5f1")]),
    ("Color of inactive/disabled text", [("inactive_fg", "#5c4e4c")]),
    ("Misc colors for processes box including mini cpu graphs, details memory "
     "graph and details status text", [("proc_misc", "#e0a44e")]),
    ("Box outline and divider line color", [
        ("cpu_box", "#8f6a55"), ("mem_box", "#8f6a55"),
        ("net_box", "#8f6a55"), ("proc_box", "#8f6a55"),
        ("div_line", "#2b2224"),
    ]),
    ("Gradient for all meters and graphs - cool teal climbing through amber "
     "into ember", [
        ("temp_start", "#7fa39b"), ("temp_mid", "#e0a44e"), ("temp_end", "#ee6d55"),
    ]),
    (None, [("cpu_start", "#9fa86a"), ("cpu_mid", "#e0a44e"), ("cpu_end", "#ee6d55")]),
    (None, [("free_start", "#9fa86a"), ("free_mid", "#a8ab68"), ("free_end", "#b7c07e")]),
    (None, [("cached_start", "#7fa39b"), ("cached_mid", "#8bb0a7"), ("cached_end", "#98bcb3")]),
    (None, [("available_start", "#e0a44e"), ("available_mid", "#e9b158"), ("available_end", "#f2bb63")]),
    (None, [("used_start", "#d98f52"), ("used_mid", "#e37a53"), ("used_end", "#ee6d55")]),
    (None, [("download_start", "#7fa39b"), ("download_mid", "#98bcb3"), ("download_end", "#b7c07e")]),
    (None, [("upload_start", "#c9714f"), ("upload_mid", "#d98f52"), ("upload_end", "#f2bb63")]),
]


def live_accent():
    for line in COLORS.read_text().splitlines():
        if line.startswith("accent"):
            return line.split('"')[1]
    raise SystemExit(f"no accent in {COLORS}")


def main():
    rotation = hue_delta(REFERENCE_ACCENT, live_accent())

    out = ["# Sadie My Love - copper & oxblood",
           f"# Generated by bin/generate-btop from colors.toml "
           f"(hue {rotation:+.1f}deg off reference). Do not hand-edit;",
           "# edit DESIGN in that script and regenerate."]

    for comment, slots in DESIGN:
        out.append("")
        if comment:
            out.append(f"# {comment}")
        for key, value in slots:
            if key is RAW:
                out.append(value)
            elif value:
                out.append(f'theme[{key}]="{rotate(value, rotation, DAMPING.get(key, 1.0))}"')
            else:
                out.append(f'theme[{key}]="{value}"')

    OUTPUT.write_text("\n".join(out) + "\n")
    print(f"btop.theme <- colors.toml (rotation {rotation:+.1f}deg)")


if __name__ == "__main__":
    main()
