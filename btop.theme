# Sadie My Love - copper & oxblood
# Generated by bin/generate-btop from colors.toml (hue +0.0deg off reference). Do not hand-edit;
# edit DESIGN in that script and regenerate.

# Main background, empty for terminal default (keeps transparency)
theme[main_bg]=""
theme_background=false

# Main text color
theme[main_fg]="#e8ddd4"

# Title color for boxes
theme[title]="#f2bb63"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#c9714f"

# Background color of selected item in processes box
theme[selected_bg]="#54313a"

# Foreground color of selected item in processes box
theme[selected_fg]="#faf5f1"

# Color of inactive/disabled text
theme[inactive_fg]="#5c4e4c"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#e0a44e"

# Box outline and divider line color
theme[cpu_box]="#8f6a55"
theme[mem_box]="#8f6a55"
theme[net_box]="#8f6a55"
theme[proc_box]="#8f6a55"
theme[div_line]="#2b2224"

# Gradient for all meters and graphs - cool teal climbing through amber into ember
theme[temp_start]="#7fa39b"
theme[temp_mid]="#e0a44e"
theme[temp_end]="#ee6d55"

theme[cpu_start]="#9fa86a"
theme[cpu_mid]="#e0a44e"
theme[cpu_end]="#ee6d55"

theme[free_start]="#9fa86a"
theme[free_mid]="#a8ab68"
theme[free_end]="#b7c07e"

theme[cached_start]="#7fa39b"
theme[cached_mid]="#8bb0a7"
theme[cached_end]="#98bcb3"

theme[available_start]="#e0a44e"
theme[available_mid]="#e9b158"
theme[available_end]="#f2bb63"

theme[used_start]="#d98f52"
theme[used_mid]="#e37a53"
theme[used_end]="#ee6d55"

theme[download_start]="#7fa39b"
theme[download_mid]="#98bcb3"
theme[download_end]="#b7c07e"

theme[upload_start]="#c9714f"
theme[upload_mid]="#d98f52"
theme[upload_end]="#f2bb63"
