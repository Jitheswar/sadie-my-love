normal-color        = "{{ foreground }}"
normal-fill-alpha   = 0.04
normal-border       = "{{ foreground }}"
normal-border-width = 1
normal-border-alpha = 0.22

hover-cursor-color        = "{{ light_foreground }}"
hover-cursor-fill-alpha   = 0.10
hover-cursor-border       = "{{ accent }}"
hover-cursor-border-width = 1
hover-cursor-border-alpha = 0.55

focus-color        = "{{ light_foreground }}"
focus-fill-alpha   = 0.10
focus-border       = "{{ accent }}"
focus-border-width = 1
focus-border-alpha = 0.55

selected-color        = "{{ bright_foreground }}"
selected-fill-alpha   = 0.20
selected-border       = "{{ accent }}"
selected-border-width = 0
selected-border-alpha = 1.0

pressed-fill-alpha   = 0.26
selection-fill-alpha = 0.38
